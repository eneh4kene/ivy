// Ivy Platform - Database Schema
// This schema defines all data models for the Ivy accountability platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic Info
  email         String  @unique
  phone         String? @unique
  firstName     String
  lastName      String
  timezone      String  @default("Europe/London")
  region        String  @default("GB") // "GB" or "US"
  currency      String  @default("GBP") // "GBP" or "USD"
  profileImage  String?

  // Subscription & Billing
  subscriptionTier   SubscriptionTier @default(FREE)
  subscriptionStatus String           @default("active") // active, paused, cancelled
  stripeCustomerId   String?          @unique
  stripeSubscriptionId String?        @unique
  companyId          String?

  // Communication Style
  commStyle       CommStyle @default(ADAPTIVE)

  // Circle preference
  circleOptIn     Boolean   @default(true)  // false = solo, true = wants a Circle // CALLS | TEXTS | ADAPTIVE

  // Schedule Preferences
  morningCallTime String? // HH:MM format (e.g., "07:00")
  eveningCallTime String? // HH:MM format (e.g., "20:00")
  callFrequency   Int     @default(2) // calls per week
  preferredDays   String? // JSON array of days ["monday", "tuesday"]

  // Workout Preferences
  track       String  // standard track: "fitness" | "focus" | "sleep" | "balance"
  trackDetail String? // personal specificity: "morning runs", "daily meditation", etc.
  goal        String  // User's primary goal
  minimumMode String? // The minimum acceptable action
  giftFrame   String? // Who/what they're doing this for

  // Coach relationship (for COACH-managed clients)
  coachId        String?   // ID of the coach User who manages this client
  coachNotes     String?   @db.Text // PT-written notes Ivy surfaces in calls
  programmeAreas Json?     // Array of { id, area, instruction } — coach-defined per client
  pendingCoachId String?   // coach invite awaiting user acceptance
  coachLinkedAt  DateTime? // when the user accepted (or was created by) the coach

  // Charity Preferences
  preferredCharityId String?

  // Stake Config (Phase 1 — product-pricing-rework.md §2 + §3)
  stakeWeeklyAmount  Decimal?    @db.Decimal(10, 2) // user-set; must be >= STAKE_CONFIG.minWeeklyStake
  forfeitMode        ForfeitMode @default(MIDDLE)
  dislikedCharityId  String?     // Savage mode: the anti-charity destination
  armingWindowStart  String?     // HH:MM — user's chosen arming window open time
  armingWindowEnd    String?     // HH:MM — user's chosen arming window deadline

  // Arming-chase opt-in (Phase 3 — §5b-i, §9 decision 4b)
  // Live Ivy-calls-you chase when the user hasn't armed. Opt-in, capped 8/user/month.
  armingChaseEnabled   Boolean   @default(false) // user opt-in; never defaulted true
  chaseCallsThisMonth  Int       @default(0)     // resets at the start of each calendar month
  chaseCapMonthStart   DateTime? // timestamp of when the current monthly window started

  // Morning call is OPT-IN only — the default daily loop is the async VN, not a live morning call (§1c)
  morningCallOptIn     Boolean   @default(false)

  // Calendar Integration (Elite+)
  googleCalendarConnected    Boolean   @default(false)
  googleCalendarRefreshToken String?
  outlookCalendarConnected   Boolean   @default(false)
  outlookCalendarRefreshToken String?

  // Behavioural intelligence
  inferredProfile Json?  // Synthesized pattern profile from call history — see insight.service.ts

  // Role
  role           String  @default("user") // "user" | "superadmin"

  // Messaging
  telegramChatId     String?   @unique // set when user connects Telegram via deep link

  // Legal consent
  tcpaConsent        Boolean   @default(false) // US users — TCPA consent for AI calls
  tcpaConsentAt      DateTime? // timestamp of consent — required for TCPA compliance record

  // Status
  isActive       Boolean @default(true)
  isOnboarded    Boolean @default(false)
  hasPaid        Boolean @default(false)
  onboardedAt    DateTime?
  lastCallAt     DateTime?

  // Relationships
  company          Company?            @relation(fields: [companyId], references: [id])
  preferredCharity Charity?            @relation("UserPreferredCharity", fields: [preferredCharityId], references: [id])
  dislikedCharity  Charity?            @relation("UserDislikedCharity", fields: [dislikedCharityId], references: [id])
  workouts         Workout[]
  calls            Call[]
  donations        Donation[]
  impactWallet     ImpactWallet?
  streaks          Streak?
  transformationScores TransformationScore[]
  lifeMarkers      LifeMarker[]
  messages         Message[]
  ivyCircles       IvyCircleMember[]
  seasons          Season[]
  impactStories    ImpactStory[]
  accountabilityBuddy AccountabilityBuddy?
  pushSubscriptions   PushSubscription[]
  charities           UserCharity[]
  callMemories        CallMemory[]
  circleGameEvents    CircleGameEvent[]
  circleCatchups      CircleCatchup[]
  stakeCycles         StakeCycle[]
  voiceNotes          VoiceNote[]
  coachProfile        CoachProfile?       // set if this user is a COACH
  clients             User[]              @relation("CoachClients")
  coach               User?               @relation("CoachClients", fields: [coachId], references: [id])
  pendingClients      User[]              @relation("PendingCoachClients")
  pendingCoach        User?               @relation("PendingCoachClients", fields: [pendingCoachId], references: [id])

  @@index([email])
  @@index([companyId])
  @@map("users")
}

enum CommStyle {
  CALLS    // Ivy always calls; text only as fallback
  TEXTS    // Ivy always texts; asks before calling
  ADAPTIVE // Ivy reads the moment and decides
}

enum SubscriptionTier {
  FREE
  PRO       // B2C: £42/mo - "Ivy" - the full system (one tier; display name "Ivy")
  ELITE     // B2C: £99/mo - "Ivy Plus" - RETIRED (kept for migration; collapse to PRO in Phase 5)
  CONCIERGE // B2C: £149/mo - "Ivy Concierge" - RETIRED (kept for migration; collapse to PRO in Phase 5)
  B2B       // Company-sponsored
  COACH     // PT / personal coach account — manages clients
}

// ============================================
// STAKE MECHANIC ENUMS
// ============================================

enum ForfeitMode {
  MIDDLE  // Default: forfeits to a house charity the user did NOT choose
  SAVAGE  // Opt-in: forfeits to a cause the user actively dislikes
}

enum StakeCycleStatus {
  AUTHORIZED // PaymentIntent authorised; no capture yet
  SETTLED    // Cycle ended; forfeited slices captured, released slices voided
  VOIDED     // Whole cycle voided (e.g. grace, error)
  FAILED     // Auth or capture failed
}

enum SliceOutcome {
  RELEASED  // Day succeeded; slice returned to user (not captured)
  FORFEITED // Day missed; slice captured and sent to forfeit destination
  PENDING   // Cycle still open; outcome not yet determined
}

// ============================================
// B2B COMPANIES
// ============================================

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name            String
  contactEmail    String
  contactName     String
  stripeCustomerId String? @unique

  // Season Configuration
  currentSeason   Int      @default(1)
  seasonStartDate DateTime?
  seasonEndDate   DateTime?
  seasonDuration  Int      @default(8) // weeks

  // Company wellness season — top-down theme that flows into every employee's call
  wellnessTheme   String? // e.g. "Move More May", "Mental Health Month"
  wellnessGoal    String? // e.g. "Every employee hits 70% consistency this season"
  wellnessSeason  Int     @default(1)

  // Pricing
  platformFeePerUser  Decimal @default(15.00)
  impactWalletPerUser Decimal @default(25.00)

  // Status
  isActive Boolean @default(true)

  // Relationships
  users       User[]
  ivyCircles  IvyCircle[]

  @@index([name])
  @@map("companies")
}

// ============================================
// CHARITIES
// ============================================

model Charity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name              String
  description       String
  category          String   // "health", "education", "environment", "poverty", "animals"
  impactMetric      String   // e.g., "meals provided", "trees planted"
  impactPerPound    String   // e.g., "2 meals per £1"
  logoUrl           String?
  website           String?
  everyOrgSlug      String?  @unique // Every.org nonprofit slug for payment dispatch

  // Filtering
  regions  String @default("[\"global\"]") @db.Text // JSON: ["GB","US","global"]
  tracks   String @default("[]")           @db.Text // JSON: ["fitness","focus","sleep","balance"]
  featured Boolean @default(false) // pinned to top of curated list

  isActive Boolean @default(true)

  // Stake mechanic — flags a charity as the Middle-mode forfeit destination pool
  isHouseDefault Boolean @default(false)

  // Relationships
  preferredByUsers  User[]        @relation("UserPreferredCharity")
  dislikedByUsers   User[]        @relation("UserDislikedCharity")
  donations         Donation[]
  userCharities     UserCharity[]
  sprintGoals       CircleSprintGoal[] @relation("SprintGoalCharity") // Phase 4b: collective charity goal

  @@index([category])
  @@index([isHouseDefault])
  @@map("charities")
}

model UserCharity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  charityId String
  charity   Charity @relation(fields: [charityId], references: [id])
  priority  Int     @default(0) // lower number = higher priority; wallet splits equally

  @@unique([userId, charityId])
  @@index([userId])
  @@map("user_charities")
}

// ============================================
// WORKOUTS & COMMITMENTS
// ============================================

model Workout {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Plan Details
  plannedDate DateTime
  plannedTime String? // HH:MM format
  activity    String  // "30 min run", "yoga session", etc.
  duration    Int?    // minutes

  // Completion Status
  status       WorkoutStatus @default(PLANNED)
  completedAt  DateTime?
  skippedReason String?

  // Type
  isMinimum Boolean @default(false) // Was this the negotiated minimum?

  // Related Call
  planningCallId String?
  reviewCallId   String?

  // Stake mechanic (Phase 1 — product-pricing-rework.md §2 + Phase 1 bullets)
  armedAt          DateTime?    // when the morning VN was accepted (arming timestamp)
  voiceNoteId      String?      @unique // FK to the canonical arming VoiceNote for this day (1:1)
  stakeCycleId     String?      // FK to StakeCycle this workout belongs to
  stakeSliceAmount Decimal?     @db.Decimal(10, 2) // daily stake slice (weeklyAmount / 7)
  sliceOutcome     SliceOutcome @default(PENDING)

  // Relationships
  voiceNote    VoiceNote?  @relation("WorkoutArmedVoiceNote", fields: [voiceNoteId], references: [id])
  stakeCycle   StakeCycle? @relation(fields: [stakeCycleId], references: [id])

  @@index([userId, plannedDate])
  @@index([status])
  @@index([stakeCycleId])
  @@map("workouts")
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
  PARTIAL   // Did minimum/modified version
  SKIPPED
  MISSED    // No show, no communication
}

// ============================================
// CALLS
// ============================================

model Call {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Call Details
  callType     CallType
  scheduledAt  DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  duration     Int?       // seconds
  status       CallStatus @default(SCHEDULED)

  // Retell Integration
  retellCallId   String? @unique
  transcript     String? @db.Text
  recordingUrl   String?

  // Call Outcome
  outcome     String? // "completed", "no_answer", "voicemail", "error"
  sentiment   String? // "positive", "neutral", "struggling"
  needsFollowUp Boolean @default(false)

  // Dynamic Variables (snapshot at call time)
  contextSnapshot Json?  // JSON of user stats, streak, etc.

  // Behavioural intelligence
  callInsights    Json?   // Structured insights extracted from transcript — see insight.service.ts
  callSummary     String? @db.Text  // Ivy's 2-3 sentence narrative summary — surfaced in next call's prompt

  // Relationships
  memories        CallMemory[]

  @@index([userId, scheduledAt])
  @@index([callType, status])
  @@index([retellCallId])
  @@map("calls")
}

enum CallType {
  MORNING_PLANNING  // Plan today's workout (legacy / opt-in preference; async VN is the default)
  EVENING_REVIEW    // Confirm completion
  RESCUE            // User-initiated "I'm about to skip"
  WEEKLY_PLANNING   // Sunday review + plan ahead
  MONTHLY_CHECKIN   // Transformation tracking
  ONBOARDING        // First call setup
  SEASON_CLOSE      // Ceremonial end-of-season call
  COACH_PONDER      // Biweekly Ivy → coach synthesis call
  ARMING_CHASE      // Opt-in live chase call when user hasn't armed (capped per §5b-i)
}

enum CallStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  FAILED
  CANCELLED
}

// ============================================
// DONATIONS & IMPACT
// ============================================

model Donation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  charityId String
  charity   Charity @relation(fields: [charityId], references: [id])

  // Amount
  amount       Decimal         @db.Decimal(10, 2)
  currency     String          @default("GBP")
  donationType DonationType
  source       DonationSource? // null for legacy wallet donations; set for stake-era donations

  // Related Workout (if applicable)
  workoutId String?

  // Related StakeCycle (for STAKE_SUCCESS / STAKE_FORFEIT)
  stakeCycleId String?

  // Streak Bonus Details
  streakDays Int?

  // Every.org dispatch tracking
  dispatchStatus   String  @default("PENDING") // PENDING | DISPATCHED | FAILED
  everyOrgChargeId String?
  dispatchError    String?
  dispatchedAt     DateTime?

  // Relationships
  stakeCycle StakeCycle? @relation(fields: [stakeCycleId], references: [id])

  @@index([userId, createdAt])
  @@index([charityId])
  @@index([dispatchStatus])
  @@index([stakeCycleId])
  @@map("donations")
}

enum DonationType {
  COMPLETION     // £1-2 per workout completion (legacy wallet mechanic)
  STREAK_7_DAY   // £3 bonus (legacy wallet mechanic)
  STREAK_30_DAY  // £10 bonus (legacy wallet mechanic)
  STREAK_90_DAY  // £25 bonus (legacy wallet mechanic)
  MANUAL         // Admin-triggered
  STAKE_SUCCESS  // Corporate-funded donation fired on a successful day
  STAKE_FORFEIT  // User's own stake forfeited to charity on a missed/unarmed day
}

enum DonationSource {
  USER_STAKE  // Comes from the user's own staked money (STAKE_FORFEIT)
  CORPORATE   // Comes from a corporate/CSR sponsor pool (STAKE_SUCCESS)
  SPONSOR     // Direct sponsor contribution (future Phase 6)
}

// ============================================
// IMPACT WALLET
// ============================================

model ImpactWallet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Wallet Limits
  monthlyLimit Decimal @db.Decimal(10, 2) // £20-50 depending on tier
  dailyCap     Decimal @db.Decimal(10, 2) // £3-5 depending on tier

  // Current Month Tracking
  currentMonthSpent Decimal  @db.Decimal(10, 2) @default(0)
  monthStartDate    DateTime

  // Lifetime Totals
  lifetimeDonated Decimal @db.Decimal(10, 2) @default(0)

  @@map("impact_wallets")
}

// ============================================
// STAKE CYCLES (Phase 1 — product-pricing-rework.md §2)
// ============================================

model StakeCycle {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cycle window (weekly — fits Stripe ~7-day auth window)
  periodStart DateTime
  periodEnd   DateTime

  // Stripe auth-and-capture
  stakeAmount            Decimal          @db.Decimal(10, 2) // full weekly stake amount authorised
  stripePaymentIntentId  String?          @unique            // the manual-capture PaymentIntent
  capturedAmount         Decimal          @db.Decimal(10, 2) @default(0) // sum of forfeited slices actually captured

  // Lifecycle
  status      StakeCycleStatus @default(AUTHORIZED)

  // Day-level counters (denormalised for quick settlement logic)
  daysArmed     Int @default(0) // days the VN was recorded before the deadline
  daysCompleted Int @default(0) // armed days where the evening review was positive
  daysForfeited Int @default(0) // missed/unarmed days whose slice was captured
  graceUsed     Int @default(0) // number of grace skips consumed this cycle

  // Relationships
  workouts  Workout[]
  donations Donation[]

  @@index([userId, periodStart])
  @@index([status])
  @@map("stake_cycles")
}

// ============================================
// VOICE NOTES (Phase 1 — product-pricing-rework.md §1c + §4)
// ============================================

model VoiceNote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link to the day's workout (the arming unit)
  workoutId String? // nullable so an orphaned VN can be stored and matched later

  // Audio source — one of these will be set depending on ingestion channel
  audioUrl        String? // URL to uploaded audio blob (PWA MediaRecorder path, per §1e)
  telegramFileId  String? // Telegram file_id (stopgap beta path only — see §1e)

  // Transcription (via Whisper / transcription.service.ts)
  transcript  String?  @db.Text
  recordedAt  DateTime
  durationSec Int?     // seconds; populated from media metadata or Whisper response

  // Relationships
  // Virtual back-relation for Workout.voiceNote (1:1; FK lives on Workout.voiceNoteId)
  armedWorkout  Workout? @relation("WorkoutArmedVoiceNote")

  @@index([userId, recordedAt])
  @@index([workoutId])
  @@map("voice_notes")
}

// ============================================
// STREAKS
// ============================================

model Streak {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current Streak
  currentStreak     Int      @default(0)
  currentStreakStart DateTime?

  // Longest Streak
  longestStreak      Int      @default(0)
  longestStreakStart DateTime?
  longestStreakEnd   DateTime?

  // Last Activity
  lastWorkoutDate DateTime?

  // Streak Bonuses Claimed
  bonus7DayClaimed  Boolean @default(false)
  bonus30DayClaimed Boolean @default(false)
  bonus90DayClaimed Boolean @default(false)

  // Grace Days (Streak Insurance)
  graceDaysBalance Int     @default(0)
  graceDaysUsed    Int     @default(0)
  graceDayLog      String? @db.Text // JSON: [{date: "ISO", reason: "7-day streak bonus"}]

  @@map("streaks")
}

// ============================================
// TRANSFORMATION TRACKING
// ============================================

model TransformationScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scores (1-10)
  energyScore         Int? // How energetic do you feel?
  moodScore           Int? // Overall mood
  healthConfidence    Int? // Confidence in health

  // Context
  weekNumber Int // Week since user started
  notes      String? @db.Text

  @@index([userId, createdAt])
  @@map("transformation_scores")
}

model LifeMarker {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Qualitative transformation moments
  marker      String @db.Text // e.g., "I took the stairs without thinking"
  category    String // "physical", "mental", "social", "professional"
  significance String // "small", "medium", "major"

  @@index([userId, createdAt])
  @@map("life_markers")
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Message Details
  channel   MessageChannel
  direction MessageDirection
  content   String         @db.Text
  status    MessageStatus  @default(SENT)

  // External IDs
  twilioSid   String? @unique
  whatsappId  String? @unique

  // Context
  messageType String? // "reminder", "nudge", "rescue_response", "quick_reply"
  relatedCallId String?

  @@index([userId, createdAt])
  @@index([channel, status])
  @@map("messages")
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
  TELEGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ============================================
// IVY CIRCLES (B2B GROUP ACCOUNTABILITY)
// ============================================

model IvyCircle {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // B2B circles belong to a company; B2C circles are standalone
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  track       String  @default("fitness") // fitness | focus | sleep | balance
  tier        String  @default("peer")    // peer | pro | celebrity

  // Collective season layer — sits on top of individual goals
  seasonTheme   String? // e.g. "Operation Ironman", "The Comeback Sprint"
  seasonNumber  Int     @default(1)

  size    Int @default(0)
  maxSize Int @default(8) // 6-8 for peer, max 4 for Concierge

  isActive Boolean @default(true)

  // Relationships
  members     IvyCircleMember[]
  sessions    CircleSprintSession[]
  sprintGoals CircleSprintGoal[]
  games       CircleGame[]

  @@index([companyId])
  @@map("ivy_circles")
}

model CircleSprintGoal {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  circleId     String
  circle       IvyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  sprintNumber Int

  // Set collectively at the sprint-start Circle session
  pledge       String   // e.g. "We all hit 80% consistency this sprint"
  theme        String?  // e.g. "Intensity sprint", "Sleep first sprint"
  targetMetric String?  // e.g. "80% group consistency"

  setByUserId String?  // facilitator who proposed it

  // Phase 4b — Collective charity goal (§4b mechanic 2): the circle nominates
  // a shared cause for this sprint.  When the linked collective game hits its
  // target the backend sets collectiveGoalHitAt.
  // IMPORTANT: no donation is fired here — the actual group donation rides on
  // STAKE_SUCCESS which requires Phase 6 corporate funding.
  // TODO(phase6): wire STAKE_SUCCESS donations to this charity once corporate
  //               funding layer is live (product-pricing-rework.md §6).
  collectiveCharityGoalId String?  // FK to Charity; the shared sprint cause
  collectiveGoalHitAt     DateTime? // set when collective game target is reached

  collectiveCharity Charity? @relation("SprintGoalCharity", fields: [collectiveCharityGoalId], references: [id], onDelete: SetNull)

  @@unique([circleId, sprintNumber])
  @@index([circleId])
  @@map("circle_sprint_goals")
}

model IvyCircleMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  circleId String
  circle   IvyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     String  @default("member") // "member" | "facilitator"
  isActive Boolean @default(true)
  joinedAt DateTime @default(now())

  // Phase 4b — Witnessed stakes (§4b mechanic 1): opt-in visibility flag.
  // When true, this member's stake status (armed/completed/forfeited + slice amount)
  // is surfaced to other members of the same circle.
  // NO money movement — visibility only.
  shareStakeWithCircle Boolean @default(false)

  @@unique([circleId, userId])
  @@index([userId])
  @@map("ivy_circle_members")
}

// ============================================
// MAGIC LINKS
// ============================================

model MagicLink {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("magic_links")
}

// ============================================
// SEASONS & SPRINTS
// ============================================

model Season {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  number      Int      // Season 1, 2, 3...
  title       String?  // "Operation Ironman", user-defined
  goal        String   // Overarching 12-week goal
  seasonType  String   @default("standard") // "standard" | "memorial" | "challenge"
  startDate   DateTime
  endDate     DateTime // startDate + 12 weeks

  status      SeasonStatus @default(ACTIVE)
  closedAt    DateTime?
  closingCallId String?    // Call ID of the Season Close ceremony

  // Season Close output
  arcSummary  String? @db.Text // AI-generated arc review
  nextGoalSuggestions String? @db.Text // JSON array of AI suggestions

  sprints     Sprint[]

  @@index([userId, status])
  @@map("seasons")
}

enum SeasonStatus {
  ACTIVE
  CLOSING  // Season Close ceremony scheduled/in-progress
  CLOSED
}

model Sprint {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  number    Int      // Sprint 1, 2, 3 within the season
  startDate DateTime
  endDate   DateTime // startDate + 4 weeks

  status    SprintStatus @default(ACTIVE)
  completedAt DateTime?

  // Sprint Close
  ivyCircleSessionId String? // CircleSprintSession that closed this sprint

  games CircleGame[]

  @@index([seasonId])
  @@map("sprints")
}

enum SprintStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ============================================
// IMPACT STORIES
// ============================================

model ImpactStory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content (tier-gated)
  textNote    String  @db.Text
  photoUrl    String?    // PRO+
  audioUrl    String?    // ELITE+
  videoUrl    String?    // CONCIERGE only

  // Context
  charityName  String
  totalDonated Decimal @db.Decimal(10, 2)
  season       Int?    // Which season number

  @@index([userId])
  @@map("impact_stories")
}

// ============================================
// ACCOUNTABILITY BUDDIES
// ============================================

model AccountabilityBuddy {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  buddyName  String
  buddyEmail String?
  buddyPhone String? // WhatsApp number with country code

  isActive     Boolean   @default(true)
  lastDigestAt DateTime?

  @@map("accountability_buddies")
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String  // Public key
  auth      String  // Auth secret
  userAgent String? // Device hint for display

  isActive  Boolean  @default(true)
  lastUsed  DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// CIRCLE SPRINT SESSIONS
// ============================================

model CircleSprintSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who facilitated
  facilitatorType String // "peer", "pro_coach", "celebrity_coach"
  facilitatorName String?

  // Session details
  scheduledAt  DateTime
  conductedAt  DateTime?
  durationMins Int?

  status       String @default("scheduled") // "scheduled", "completed", "cancelled"

  // Linked circle (persistent group)
  circleId String?
  circle   IvyCircle? @relation(fields: [circleId], references: [id])

  // Participants (JSON array of user IDs)
  participantUserIds String @db.Text // JSON

  // Sprint context
  sprintId     String?
  sprintNumber Int?

  // Session outcomes — set after the session
  collectivePledge String? // what the group committed to next sprint
  highlights       String? @db.Text // JSON — key moments Ivy surfaces in individual calls

  catchups CircleCatchup[]

  @@index([sprintId])
  @@index([circleId])
  @@map("circle_sprint_sessions")
}

// ============================================
// COACH PROFILE (set when user is a COACH tier)
// ============================================

model CoachProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Programme identity
  programmeName   String   // e.g. "12-week Fat Loss", "Marathon Prep"
  coachingStyle   String?  // e.g. "direct and data-driven", "nurturing, long-term mindset"
  programmeNotes  String?  @db.Text // general instructions for all clients

  // White-labelling (optional, coach decides)
  whitelabelEnabled Boolean @default(false)
  brandName         String? // replaces "Ivy" in client-facing comms
  brandLogoUrl      String? // optional logo URL

  // Shareable invite link — coach shares this URL, no email needed
  inviteToken String? @unique // random token; /invite/[token] is the public landing page

  // Alert preferences
  alertOnMissedCalls Int @default(3) // notify coach after N consecutive missed calls
  weeklyDigestEnabled Boolean @default(true)
  ponderCallEnabled   Boolean @default(false)
  ponderCallDay       Int?    // 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
  ponderCallTime      String? // HH:MM
  ponderCallFrequency String  @default("weekly") // "weekly" | "fortnightly"

  @@map("coach_profiles")
}

// ============================================
// CIRCLE CATCH-UP (for members who miss a sprint session)
// ============================================

model CircleCatchup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String
  session   CircleSprintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // What Ivy needs to cover in the catch-up call
  sprintNumber    Int
  collectivePledge String   @db.Text
  highlights      String?  @db.Text // key moments from the session

  // Cleared once Ivy covers it in a call, or after 48h (stale)
  coveredAt  DateTime?
  expiresAt  DateTime  // createdAt + 48h

  @@unique([userId, sessionId])
  @@index([userId, coveredAt])
  @@map("circle_catchups")
}

// ============================================
// GAME SUGGESTIONS (global library, curated by Ivy superadmin)
// ============================================

model GameSuggestion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String   // one-liner shown in the card
  templateType String  @default("custom") // relay | points_race | collective | custom

  // Pre-written Ivy instruction — circles can adopt as-is or edit
  ivyInstruction String @db.Text

  // Filtering metadata
  tracks String @default("[]") @db.Text // JSON: ["fitness","focus","sleep","balance"] — empty = all
  tags   String @default("[]") @db.Text // JSON: ["seasonal","christmas","outdoor","social","focus","reading"]

  published  Boolean @default(false)
  usageCount Int     @default(0) // incremented each time a circle starts a game from this suggestion

  createdByEmail String? // who added it (audit trail)

  @@index([published])
  @@map("game_suggestions")
}

// ============================================
// CIRCLE GAMES
// ============================================

model CircleGame {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circleId  String
  circle    IvyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  sprintId  String?
  sprint    Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  // Identity
  name        String
  description String?

  // Template type hints to the state processor which mechanics to apply
  templateType String @default("custom")
  // relay — baton passes to next member on workout_completed; missed = baton drops to random
  // points_race — each workout_completed awards points; first to target wins
  // collective — whole circle unlocks reward when group total hits target
  // custom — Ivy reads ivyInstruction and manages everything conversationally

  // Template-specific parameters (e.g. turn_order, window_hours, scoring, win_condition)
  rules Json @default("{}")

  // Plain English for Ivy — the *only* thing Ivy reads to understand how to run the game
  ivyInstruction String @db.Text

  // Mechanical runtime state — updated by backend on every workout event
  state Json @default("{}")
  // relay:    { current_holder_id, baton_held_since, passes_today }
  // points:   { scores: { userId: Int } }
  // collective:{ total: Int, target: Int, contributors: [userId] }
  // custom:   freeform, set by the game creator

  status    String   @default("active") // active | completed | paused
  startedAt DateTime @default(now())
  completedAt DateTime?

  events CircleGameEvent[]

  @@index([circleId, status])
  @@index([sprintId])
  @@map("circle_games")
}

model CircleGameEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  gameId String
  game   CircleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // workout_completed | workout_missed | baton_passed | points_awarded | streak_extended | game_won
  eventType String
  payload   Json   @default("{}")
  note      String? // plain sentence Ivy can surface in a call

  @@index([gameId, createdAt])
  @@index([userId])
  @@map("circle_game_events")
}

// ============================================
// CALL MEMORY (Long-term curated moments — Layer 3)
// ============================================

model CallMemory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  content   String   @db.Text  // memorable fact as Ivy observed it
  category  String             // motivation | life_event | personal_detail | struggle | breakthrough

  @@index([userId, createdAt])
  @@map("call_memories")
}

// ============================================
// API USAGE TRACKING
// ============================================

model ApiUsageLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String?
  service   String  // "retell" | "twilio" | "sendgrid" | "whatsapp"
  operation String  // "call" | "sms" | "email" | "whatsapp_message"
  units     Float   // seconds for calls, count for messages
  costGbp   Float   // estimated cost in GBP
  metadata  String? @db.Text // JSON — call ID, message ID, etc.

  @@index([userId])
  @@index([service, createdAt])
  @@index([createdAt])
  @@map("api_usage_logs")
}
