
# ============================================================
# LAUNCH-CRITICAL — Must be set before going live
# ============================================================

# Retell AI — voice calls are the core product, nothing works without this
# Get API key and agent IDs from retellai.com
RETELL_API_KEY=
RETELL_AGENT_ID_B2C=
RETELL_AGENT_ID_B2B=

# Twilio — outbound call routing via Retell
# Verify both numbers before launch — UK for GBP users, US for USD users
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+44xxxxxxxxxx
TWILIO_PHONE_NUMBER_US=+1xxxxxxxxxx

# Stripe — payments
# Use sk_test_/pk_test_ for staging, sk_live_/pk_live_ for production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs — GBP (create in Stripe dashboard under Products)
# Ivy £70/mo | Ivy Plus £99/mo | Ivy Concierge £149/mo
# B2B Team £45/employee/mo | B2B Champion £65/employee/mo
STRIPE_PRICE_PRO_GBP=
STRIPE_PRICE_ELITE_GBP=
STRIPE_PRICE_CONCIERGE_GBP=
STRIPE_PRICE_B2B_TEAM_GBP=
STRIPE_PRICE_B2B_CHAMPION_GBP=

# Stripe price IDs — USD (create matching USD prices in Stripe dashboard)
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_ELITE_USD=
STRIPE_PRICE_CONCIERGE_USD=
STRIPE_PRICE_B2B_TEAM_USD=
STRIPE_PRICE_B2B_CHAMPION_USD=

# Email — magic links, Witness emails, buddy digests
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, verify sending domain before launch
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=Ivy <noreply@yourdomain.com>


# ============================================================
# INFRASTRUCTURE — Configure per deployment environment
# ============================================================

NODE_ENV=production
PORT=3001
API_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# PostgreSQL — use a hosted provider (Railway, Supabase, Neon) in production
DATABASE_URL=postgresql://username:password@localhost:5432/ivy_db?schema=public

# Redis — Bull job queues for call scheduling and weekly digests
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
MAGIC_LINK_EXPIRES_IN=15m

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info


# ============================================================
# NICE TO HAVE AT LAUNCH — app works without these, with reduced features
# ============================================================

# WhatsApp Business API — nudges and weekly Witness/buddy digests
# App skips gracefully if not set — not a launch blocker
# Get from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=


# ============================================================
# POST-LAUNCH — Phase 2 features, not needed at launch
# ============================================================

# Google Calendar integration (Ivy Plus and Concierge)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/calendar/google/callback

# Microsoft Calendar integration (Ivy Plus and Concierge)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.yourdomain.com/api/calendar/microsoft/callback
