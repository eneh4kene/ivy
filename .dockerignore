# Backend image build context.
#
# The builder stage runs `npm ci` and THEN `COPY . .`, so without this file the
# local (macOS-built) node_modules is copied over the container's Alpine-built
# one, and .env is baked into the image. Both are fixed by excluding them here.
#
# Keep: src/, prisma/, package*.json, tsconfig.json — that's all `npm run build`
# needs. Everything below is dead weight or actively harmful.

# Dependencies — reinstalled inside the image for the right platform/libc
node_modules
*/node_modules

# The Next.js app deploys to Vercel, not into this image (2.4 GB of the context)
frontend

# Build output — regenerated by `npm run build` in the builder stage
dist
build

# VCS and editor noise
.git
.gitignore
.github
.vscode
.idea
.specstory
.DS_Store

# Secrets — must never be baked into an image layer
.env
.env.*
!.env.example

# Docs, specs, logs, local scratch
docs
logs
*.log
ivy specs
README.md
*.md

# Tests and coverage — not run in the production image
tests
coverage
.jest-cache

# Local tooling
.claude
docker-compose.yml
